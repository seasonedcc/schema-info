{
  "name": "schema-info",
  "version": "0.0.1",
  "description": "Universal schema introspection for TypeScript validation libraries",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": ["README.md", "./dist/*"],
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && tsup ./src/index.ts --format esm,cjs --dts",
    "dev": "tsup ./src/index.ts --format esm,cjs --watch --dts",
    "tsc": "tsc",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings",
    "lint-fix": "biome check --write --error-on-warnings"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seasonedcc/schema-info.git"
  },
  "bugs": {
    "url": "https://github.com/seasonedcc/schema-info/issues"
  },
  "homepage": "https://github.com/seasonedcc/schema-info#readme",
  "keywords": [
    "schema",
    "introspection",
    "zod",
    "yup",
    "valibot",
    "arktype",
    "effect",
    "joi",
    "validation",
    "typescript"
  ],
  "author": "Daniel Weinmann",
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "arktype": "^2.2.0",
    "effect": "^3.20.0",
    "joi": "^18.0.2",
    "tsup": "^8.3.5",
    "typescript": "5.8.3",
    "valibot": "^1.3.1",
    "vite": "6.0.7",
    "vitest": "2.1.8",
    "yup": "^1.7.1",
    "zod": "^4.0.0"
  }
}
